# Copy this file as .env ON THE SERVER. Never commit or share .env.
# Set the actual DNS A record to your server IPv4 first.
DOMAIN=beta.example.com
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_MASTER_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
# Set an unpredictable invite code and share only with approved testers
BETA_INVITE_CODE=REPLACE_WITH_LONG_PRIVATE_INVITE_CODE

# Free mode (optional). Leave PLATFORM_OPENROUTER_API_KEY empty to turn it off.
# Create a dedicated key at https://openrouter.ai/keys and give it a credit limit there as a hard backstop.
PLATFORM_OPENROUTER_API_KEY=
# Cheap models only; members get these without sound (add a Thai voice-over when posting)
PLATFORM_MODELS=google/veo-3.1-lite
# Free clips per member per period: day | month | total
PLATFORM_CLIPS_PER_USER=3
PLATFORM_QUOTA_PERIOD=month
# All members together; estimated list price, about 20 Veo Lite clips at the default
PLATFORM_DAILY_BUDGET_USD=5

# Video models members may start (free mode and their own keys), as provider:model, comma separated.
# 'all' re-opens every model, e.g. openrouter:google/veo-3.1-lite,xai:grok-imagine-video-1.5-lite
ENABLED_VIDEO_MODELS=openrouter:google/veo-3.1-lite
